# Copie este arquivo para .env e preencha os valores.

# Porta da API (padrão: 3001)
PORT=3001

# Origens autorizadas a chamar a API, separadas por vírgula
# (em produção, coloque o domínio do site, ex.: https://ganmassagemcorporativa.com.br)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Servidor SMTP do Zoho Mail
# Contas pagas/domínio próprio: smtppro.zoho.com | Contas gratuitas: smtp.zoho.com
SMTP_HOST=smtppro.zoho.com
# 465 com SMTP_SECURE=true (SSL) ou 587 com SMTP_SECURE=false (STARTTLS)
SMTP_PORT=465
SMTP_SECURE=true

# Conta que envia o e-mail (também usada como remetente)
SMTP_USER=contato@ganmassagemcorporativa.com.br
# Senha da conta ou, se tiver 2FA ativo, uma "senha específica de aplicativo" gerada no Zoho
SMTP_PASS=

# Endereço que recebe as mensagens do formulário
EMAIL_TO=contato@ganmassagemcorporativa.com.br
